DATABASE_URL=postgres://food:food_local_only@localhost:5433/food_delivery
# Redis Pub/Sub for live notification pushes. Optional: without REDIS_URL the
# SSE stream is disabled and the client falls back to slow polling.
REDIS_URL=redis://:redis_local_only@localhost:6379
REDIS_PASSWORD=redis_local_only
PORT=3001
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
PAYMENT_MODE=simulated
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
PAYMENT_WINDOW_MINUTES=15
DEMO_MODE=true
DEMO_PASSWORD=LocalDemo123!
# OpenStreetMap import (server-side only; the admin API never accepts a URL)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_HANOI_BBOX=20.95,105.75,21.1,105.9
OVERPASS_TIMEOUT_MS=30000
OVERPASS_RETRIES=3
OVERPASS_MAX_ELEMENTS=2000
IMPORT_BATCH_SIZE=50
# The public demo catalog is fictional and needs no external API key.

# Geocoding adapter. "photon" (default) and "nominatim" are supported.
# These are public OpenStreetMap-based services: use a low request rate and do
# not deploy them as an unmonitored production geocoder.
GEOCODING_PROVIDER=photon
# GEOCODING_BASE_URL=https://photon.komoot.io
GEOCODING_TIMEOUT_MS=6000
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_MIN_INTERVAL_MS=300
GEOCODING_USER_AGENT=BepFoodDelivery/1.0 (local development)

# Pedestrian routing adapter (Valhalla, costing=pedestrian).
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
ROUTING_TIMEOUT_MS=6000
ROUTING_CACHE_TTL_SECONDS=600
ROUTING_MAX_CONCURRENCY=3
ROUTING_USER_AGENT=BepFoodDelivery/1.0 (local development)
# Maximum time a catalog request waits for route lookups before degrading.
DELIVERY_LOOKUP_BUDGET_MS=8000

# Demo shipping formula: 0-2 km = 10,000 VND; +3,000 per started extra km;
# over 15 km is unsupported.
SHIPPING_BASE_DISTANCE_METERS=2000
SHIPPING_BASE_FEE=10000
SHIPPING_EXTRA_KM_FEE=3000
SHIPPING_MAX_DISTANCE_METERS=15000

# Frontend map tiles (Vite build-time values). Keep the OSM attribution.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Optional: set to "query" to log every Prisma query in development
# PRISMA_LOG=query

# Redis 
REDIS_URL=redis://:redis_local_only@localhost:6379
REDIS_PASSWORD=redis_local_only