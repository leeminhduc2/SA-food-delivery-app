generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id
  email              String             @unique
  name               String
  password_hash      String
  role               String
  active             Boolean            @default(true)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  addresses          Address[]
  carts              Cart?
  complaints         Complaint[] @relation("ComplaintCustomer")
  reported_complaints Complaint[] @relation("ComplaintReporter")
  deliveries         Delivery[]
  assignments        DriverAssignment[]
  notifications      Notification[]
  orders             Order[]            @relation("OrderCustomer")
  outbox             Outbox[]
  restaurant_members RestaurantMember[]
  reviews            Review[]
  sessions           Session[]

  @@map("users")
}

model Address {
  id                String          @id
  user_id           String
  address           String
  formatted_address String?
  latitude          Float
  longitude         Float
  is_default        Boolean         @default(true)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @updatedAt @db.Timestamptz(6)
  delivery_quotes   DeliveryQuote[]
  user              User            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "addresses_user")
  @@map("addresses")
}

model Session {
  token_hash String   @id
  user_id    String
  expires_at DateTime @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sessions")
}

model Restaurant {
  id                     String             @id
  name                   String
  description            String
  address                String
  cuisine                String
  image                  String             @default("")
  status                 String             @default("PENDING")
  delivery_fee           Int                @default(15000)
  eta_minutes            Int                @default(30)
  approved_at            DateTime?          @db.Timestamptz(6)
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  source                 String             @default("MANUAL")
  verified               Boolean            @default(true)
  owner_managed          Boolean            @default(true)
  osm_type               String?
  osm_id                 String?
  latitude               Float?
  longitude              Float?
  phone                  String?
  website                String?
  opening_hours          String?
  opening_schedule       Json?
  address_tags           Json               @default("{}")
  osm_tags               Json               @default("{}")
  imported_at            DateTime?          @db.Timestamptz(6)
  last_synced_at         DateTime?          @db.Timestamptz(6)
  catalog_visible        Boolean            @default(true)
  accepting_orders       Boolean            @default(true)
  geocoded_address       String?
  geocoded_at            DateTime?          @db.Timestamptz(6)
  slug                   String?
  district               String?
  mock                   Boolean            @default(false)
  rating                 Float?
  review_count           Int                @default(0)
  google_place_id        String?            @unique(map: "restaurants_google_place")
  google_maps_uri        String?
  google_primary_type    String?
  google_business_status String?
  photo_name             String?
  photo_attribution      Json               @default("[]")
  photo_verified_food    Boolean            @default(false)
  places_synced_at       DateTime?          @db.Timestamptz(6)
  items                  MenuItem[]
  menus                  Menu[]
  orders                 Order[]
  members                RestaurantMember[]
  reviews                Review[]
  delivery_quotes        DeliveryQuote[]

  @@map("restaurants")
}

model RestaurantImportJob {
  id           String    @id
  requested_by String
  endpoint     String
  bbox         String
  dry_run      Boolean   @default(false)
  status       String    @default("RUNNING")
  stats        Json      @default("{}")
  error        String?
  started_at   DateTime  @default(now()) @db.Timestamptz(6)
  finished_at  DateTime? @db.Timestamptz(6)

  @@index([started_at(sort: Desc)], map: "restaurant_import_recent")
  @@map("restaurant_import_jobs")
}

model RestaurantMember {
  user_id       String
  restaurant_id String
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          User       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, restaurant_id])
  @@map("restaurant_members")
}

model Menu {
  id            String     @id
  restaurant_id String
  name          String
  items         MenuItem[]
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([restaurant_id, name])
  @@map("menus")
}

model MenuItem {
  id            String      @id
  restaurant_id String
  menu_id       String
  name          String
  description   String      @default("")
  price         Int
  image         String      @default("")
  available     Boolean     @default(true)
  visible       Boolean     @default(true)
  stock         Int         @default(30)
  low_stock_threshold Int?
  options       Json        @default("[]")
  mock          Boolean     @default(false)
  menu          Menu        @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  restaurant    Restaurant  @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order_items   OrderItem[]
  stock_movements StockMovement[]

  @@index([restaurant_id], map: "items_restaurant")
  @@index([restaurant_id, visible], map: "items_restaurant_visible")
  @@map("menu_items")
}

model StockMovement {
  id String @id
  item_id String
  kind String
  delta Int
  balance_after Int
  actor String
  reason String
  operation_key String
  order_id String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  item MenuItem @relation(fields: [item_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([item_id, operation_key])
  @@index([item_id, created_at(sort: Desc), id(sort: Desc)], map: "stock_movements_item_time")
  @@map("stock_movements")
}

model Cart {
  customer_id String @id
  items       Json   @default("[]")
  version     Int    @default(0)
  customer    User   @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("carts")
}

model Order {
  id                       String         @id
  customer_id              String
  restaurant_id            String
  status                   String
  subtotal                 Int
  delivery_fee             Int
  total                    Int
  currency                 String         @default("VND")
  address                  String
  delivery_latitude        Float?
  delivery_longitude       Float?
  walking_distance_meters  Int?
  walking_duration_seconds Int?
  note                     String         @default("")
  idempotency_key          String
  fingerprint              String
  stock_released           Boolean        @default(false)
  expires_at               DateTime       @db.Timestamptz(6)
  created_at               DateTime       @default(now()) @db.Timestamptz(6)
  complaints               Complaint[]
  delivery                 Delivery?
  items                    OrderItem[]
  customer                 User           @relation("OrderCustomer", fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  restaurant               Restaurant     @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment                  Payment?
  review                   Review?
  history                  StateHistory[]

  @@unique([customer_id, idempotency_key])
  @@index([customer_id, created_at(sort: Desc)], map: "orders_customer")
  @@index([restaurant_id, status], map: "orders_restaurant")
  @@index([status, expires_at], map: "orders_pending")
  @@map("orders")
}

model OrderItem {
  id           String   @id
  order_id     String
  menu_item_id String
  name         String
  price        Int
  quantity     Int
  options      Json
  menu_item    MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order        Order    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("order_items")
}

model Payment {
  id                      String         @id
  order_id                String         @unique
  reference               String         @unique
  amount                  Int
  currency                String         @default("VND")
  status                  String         @default("PENDING")
  external_transaction_id String?        @unique
  provider_created        Boolean        @default(false)
  reconciliation_required Boolean        @default(false)
  created_at              DateTime       @default(now()) @db.Timestamptz(6)
  next_reconcile_at       DateTime       @default(now()) @db.Timestamptz(6)
  events                  PaymentEvent[]
  order                   Order          @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("payments")
}

model PaymentEvent {
  event_id     String   @id
  reference    String
  payload_hash String
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  payment      Payment  @relation(fields: [reference], references: [reference], onDelete: NoAction, onUpdate: NoAction)

  @@map("payment_events")
}

model SimulatedTransaction {
  reference   String @id
  amount      Int
  status      String @default("PENDING")
  external_id String @unique

  @@map("simulated_transactions")
}

model RefundRequest {
  id              String    @id
  order_id        String
  payment_id      String
  customer_id     String?
  source          String
  incident_id     String?
  complaint_id    String?
  requested_by    String
  requester_role  String
  reason          String
  amount          Int
  status          String
  decided_by      String?
  decision_reason String?
  decided_at      DateTime? @db.Timestamptz(6)
  attempts        Int       @default(0)
  next_attempt_at DateTime? @db.Timestamptz(6)
  lease_until     DateTime? @db.Timestamptz(6)
  last_error      String?
  confirmed_at    DateTime? @db.Timestamptz(6)
  key_hash        String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  history         RefundRequestHistory[]

  @@index([status, next_attempt_at], map: "refund_requests_due")
  @@map("refund_requests")
}

model RefundRequestHistory {
  id                String        @id
  refund_request_id String
  from_status       String?
  to_status         String
  actor             String
  reason            String?
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  refund_request    RefundRequest @relation(fields: [refund_request_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([refund_request_id, created_at], map: "refund_request_history_request")
  @@map("refund_request_history")
}

model Delivery {
  id          String             @id
  order_id    String             @unique
  driver_id   String?
  status      String             @default("UNASSIGNED")
  arrived_at DateTime? @db.Timestamptz(6)
  picked_up_at DateTime? @db.Timestamptz(6)
  in_transit_at DateTime? @db.Timestamptz(6)
  delivered_at DateTime? @db.Timestamptz(6)
  failed_at DateTime? @db.Timestamptz(6)
  proof_required Boolean @default(false)
  updated_at  DateTime           @default(now()) @db.Timestamptz(6)
  driver      User?              @relation(fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order       Order              @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments DriverAssignment[]
  otp_challenges DeliveryOtpChallenge[]
  otp_attempts DeliveryOtpAttempt[]
  proofs DeliveryProof[]

  @@index([driver_id, status], map: "deliveries_driver")
  @@map("deliveries")
}

model DriverAssignment {
  id          String   @id
  delivery_id String
  driver_id   String
  active      Boolean  @default(true)
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  ended_at DateTime? @db.Timestamptz(6)
  end_reason String?
  delivery    Delivery @relation(fields: [delivery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver      User     @relation(fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  otp_challenges DeliveryOtpChallenge[]
  proofs DeliveryProof[]

  @@map("driver_assignments")
}

model DriverEarningEstimate {
  id           String   @id
  delivery_id  String   @unique
  order_id     String
  driver_id    String
  amount       Int
  currency     String   @default("VND")
  delivered_at DateTime @db.Timestamptz(6)
  basis        String   @default("SIMULATED_ESTIMATE")
  source       String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([driver_id, delivered_at(sort: Desc), id(sort: Desc)], map: "driver_earning_estimates_driver_time")
  @@map("driver_earning_estimates")
}

model DeliveryOtpChallenge {
  id String @id
  order_id String
  delivery_id String
  assignment_id String
  customer_id String
  salt String
  otp_hash String
  status String @default("ACTIVE")
  attempts Int @default(0)
  expires_at DateTime @db.Timestamptz(6)
  key_hash String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  delivery Delivery @relation(fields: [delivery_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment DriverAssignment @relation(fields: [assignment_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempts_log DeliveryOtpAttempt[]
  proof DeliveryProof?
  @@unique([order_id, customer_id, key_hash])
  @@index([order_id, created_at(sort: Desc)], map: "delivery_otp_challenges_order_created")
  @@map("delivery_otp_challenges")
}

model DeliveryProof {
  id String @id
  delivery_id String
  assignment_id String
  challenge_id String? @unique
  method String
  status String
  driver_id String?
  storage_key String? @unique
  content_type String?
  byte_size Int?
  sha256 String?
  key_hash String?
  purged_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  delivery Delivery @relation(fields: [delivery_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment DriverAssignment @relation(fields: [assignment_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  challenge DeliveryOtpChallenge? @relation(fields: [challenge_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempts DeliveryOtpAttempt[]
  @@index([delivery_id, assignment_id, status], map: "delivery_proofs_assignment")
  @@map("delivery_proofs")
}

model DeliveryProofUpload {
  storage_key String @id
  delivery_id String
  attempts Int @default(0)
  last_error String?
  next_attempt_at DateTime @default(now()) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  @@index([next_attempt_at], map: "delivery_proof_uploads_due")
  @@map("delivery_proof_uploads")
}

model DeliveryOtpAttempt {
  id String @id
  delivery_id String
  challenge_id String
  driver_id String
  key_hash String
  outcome String
  proof_id String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  delivery Delivery @relation(fields: [delivery_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  challenge DeliveryOtpChallenge @relation(fields: [challenge_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  proof DeliveryProof? @relation(fields: [proof_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([delivery_id, driver_id, key_hash])
  @@map("delivery_otp_attempts")
}

model StateHistory {
  id         String   @id
  order_id   String
  entity     String
  from_state String?
  to_state   String
  actor      String
  reason     String   @default("")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  sequence   BigInt   @default(autoincrement())
  order      Order    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("state_history")
}

model Outbox {
  id           String        @id
  user_id      String
  type         String
  payload      Json
  attempts     Int           @default(0)
  available_at DateTime      @default(now()) @db.Timestamptz(6)
  processed_at DateTime?     @db.Timestamptz(6)
  last_error   String?
  notification Notification?
  user         User          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("outbox")
}

model Notification {
  id         String   @id
  user_id    String
  type       String
  payload    Json
  read       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  outbox     Outbox   @relation(fields: [id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("notifications")
}

model Review {
  id            String     @id
  order_id      String     @unique
  customer_id   String
  restaurant_id String
  rating        Int
  content       String
  hidden        Boolean    @default(false)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  customer      User       @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order         Order      @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reply               ReviewReply?
  moderation_requests ReviewModerationRequest[]

  @@map("reviews")
}

model Complaint {
  id            String             @id
  order_id      String
  customer_id   String?
  reporter_id   String
  reporter_role String
  content       String
  status        String             @default("OPEN")
  resolution    String?
  resolved_by   String?
  resolved_at   DateTime?          @db.Timestamptz(6)
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  customer      User?              @relation("ComplaintCustomer", fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reporter      User               @relation("ComplaintReporter", fields: [reporter_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order         Order              @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  history       ComplaintHistory[]

  @@index([reporter_id, created_at(sort: Desc)], map: "complaints_reporter")
  @@index([order_id, status], map: "complaints_order_status")
  @@map("complaints")
}

model ComplaintHistory {
  id           String    @id
  complaint_id String
  actor_id     String
  action       String
  note         String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  complaint    Complaint @relation(fields: [complaint_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([complaint_id, created_at], map: "complaint_history_complaint")
  @@map("complaint_history")
}

model ReviewReply {
  id            String                @id
  review_id     String                @unique
  restaurant_id String
  author_id     String
  content       String
  revision      Int                   @default(1)
  created_at    DateTime              @default(now()) @db.Timestamptz(6)
  updated_at    DateTime              @default(now()) @db.Timestamptz(6)
  review        Review                @relation(fields: [review_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  revisions     ReviewReplyRevision[]

  @@map("review_replies")
}

model ReviewReplyRevision {
  id         String      @id
  reply_id   String
  revision   Int
  author_id  String
  content    String
  key_hash   String
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  reply      ReviewReply @relation(fields: [reply_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([reply_id, revision])
  @@unique([author_id, reply_id, key_hash], map: "review_reply_revisions_receipt")
  @@map("review_reply_revisions")
}

model ReviewModerationRequest {
  id              String    @id
  review_id       String
  restaurant_id   String
  requester_id    String
  reason          String
  status          String    @default("PENDING")
  decided_by      String?
  decision_reason String?
  decided_at      DateTime? @db.Timestamptz(6)
  key_hash        String
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  review          Review    @relation(fields: [review_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([requester_id, review_id, key_hash])
  @@index([status, created_at], map: "review_moderation_status")
  @@map("review_moderation_requests")
}

model AuditLog {
  id             String   @id
  actor          String
  action         String
  resource_id    String
  resource_type  String?
  outcome        String?  @default("UNKNOWN")
  correlation_id String?
  detail         Json     @default("{}")
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("audit_logs")
}

/**
 * One persisted walking quote per (address, restaurant). Only deterministic
 * outcomes are cached: AVAILABLE and OUT_OF_RANGE. Transient provider failures
 * must be recomputed instead of being frozen into a stale price.
 */
model DeliveryQuote {
  id                   String     @id
  address_id           String
  restaurant_id        String
  status               String
  reason               String?
  distance_meters      Int?
  duration_seconds     Int?
  shipping_fee         Int?
  currency             String     @default("VND")
  route_geometry       Json?
  address_latitude     Float
  address_longitude    Float
  restaurant_latitude  Float
  restaurant_longitude Float
  pricing_key          String
  computed_at          DateTime   @default(now()) @db.Timestamptz(6)
  expires_at           DateTime   @db.Timestamptz(6)
  address              Address    @relation(fields: [address_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  restaurant           Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([address_id, restaurant_id], map: "delivery_quotes_address_restaurant_key")
  @@index([restaurant_id], map: "delivery_quotes_restaurant_idx")
  @@index([expires_at], map: "delivery_quotes_expires_idx")
  @@map("delivery_quotes")
}

/**
 * One-time seed marker; reruns must not overwrite operator edits.
 */
model SeedRun {
  name       String   @id
  version    Int
  applied_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("seed_runs")
}

model DriverAvailability {
  driver_id String @id
  online Boolean @default(false)
  ready Boolean @default(false)
  heartbeat_at DateTime? @db.Timestamptz(6)
  version Int @default(0)
  @@map("driver_availability")
}

model DriverOperationalChange {
  id String @id
  driver_id String
  source String
  reason String
  observed_version Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
  lease_owner String?
  lease_until DateTime? @db.Timestamptz(6)
  attempts Int @default(0)
  due_at DateTime @default(now()) @db.Timestamptz(6)
  @@map("driver_operational_changes")
}

model DeliveryIncident {
  id String @id
  delivery_id String
  order_id String
  type String
  status String @default("OPEN")
  reason String
  actor_id String?
  evidence Json @default("[]")
  resolution String?
  resolution_reason String?
  resolved_by String?
  resolved_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  history DeliveryIncidentHistory[]
  @@index([delivery_id, status], map: "delivery_incidents_delivery_status")
  @@map("delivery_incidents")
}

model DeliveryIncidentHistory {
  id String @id
  incident_id String
  action String
  actor_id String
  reason String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  incident DeliveryIncident @relation(fields: [incident_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([incident_id, created_at], map: "delivery_incident_history_incident")
  @@map("delivery_incident_history")
}

model DriverLocation {
  driver_id String @id
  latitude Float
  longitude Float
  captured_at DateTime @db.Timestamptz(6)
  received_at DateTime @db.Timestamptz(6)
  version Int @default(1)
  @@map("driver_locations")
}


model AssignmentSearch {
  id String @id
  delivery_id String
  generation Int @default(1)
  status String @default("WAITING")
  strategy String @default("NEAREST")
  round Int @default(1)
  offers_created Int @default(0)
  deadline_at DateTime @db.Timestamptz(6)
  next_run_at DateTime @default(now()) @db.Timestamptz(6)
  lease_owner String?
  lease_until DateTime? @db.Timestamptz(6)
  version Int @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  @@unique([delivery_id, generation])
  @@index([status, next_run_at], map: "assignment_search_due")
  @@map("assignment_searches")
}

model AssignmentSearchEvent {
  id String @id
  search_id String
  round Int
  event String
  reason String?
  next_run_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  @@index([search_id, created_at, id], map: "assignment_search_events_search_created")
  @@map("assignment_search_events")
}

model OperationalAlertAcknowledgement {
  kind String
  resource_id String
  actor_id String
  acknowledged_at DateTime @default(now()) @db.Timestamptz(6)
  @@id([kind, resource_id])
  @@map("operational_alert_acknowledgements")
}

model DriverOffer {
  id String @id
  search_id String
  driver_id String
  status String @default("OFFERED")
  expires_at DateTime @db.Timestamptz(6)
  responded_at DateTime? @db.Timestamptz(6)
  assignment_id String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  @@index([search_id, created_at], map: "driver_offers_search")
  @@map("driver_offers")
}

model AssignmentAttempt {
  id String @id
  search_id String
  driver_id String
  round Int
  rank Int?
  criterion Json?
  offer_id String?
  outcome String
  reason String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  @@unique([search_id, driver_id])
  @@map("assignment_attempts")
}
